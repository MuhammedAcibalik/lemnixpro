# Root bootstrap variables for local infrastructure only.
# Service-specific environment files belong to the owning service or engine.

NODE_ENV=development
POSTGRES_DB=lemnixpro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
INTERNAL_SERVICE_AUTH_SECRET=lemnixpro-local-internal

# Yerel servis .env (gateway, kimlik, optimization-orchestrator, result, …) kök INTERNAL_SERVICE_AUTH_SECRET ile hizalamak için: pnpm sync:service-env
