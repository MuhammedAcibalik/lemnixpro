SERVICE_NAME=master-data-service
NODE_ENV=development
LOG_LEVEL=info
ENABLE_SWAGGER=true
PORT=3003
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lemnixpro
# production-plan ile aynı sırrı kullanın (production zorunlu; development isteğe bağlı).
INTERNAL_SERVICE_AUTH_SECRET=replace-with-a-shared-internal-service-secret
# Profil oluştur/güncelle/import sonrası kesim listesi eşleşmesi için production-plan bu adrese POST atar.
# Boş bırakılırsa tetiklenmez. Yerelde örnek: http://127.0.0.1:3004
PRODUCTION_PLAN_SERVICE_BASE_URL=http://localhost:3004
