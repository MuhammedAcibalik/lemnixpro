SERVICE_NAME=cut-list-service
NODE_ENV=development
LOG_LEVEL=info
ENABLE_SWAGGER=true
PORT=3005
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lemnixpro
INTERNAL_SERVICE_AUTH_SECRET=replace-with-a-shared-internal-service-secret
UPSTREAM_REQUEST_TIMEOUT_MS=8000
PRODUCTION_PLAN_SERVICE_BASE_URL=http://localhost:3004
MASTER_DATA_SERVICE_BASE_URL=http://localhost:3003
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Optional: override reconcile consumer queues (defaults use *.v2 to avoid RabbitMQ PRECONDITION_FAILED after queue-arg changes).
# CUT_LIST_BATCH_RECONCILE_QUEUE=cut-list.production-plan.batch-cut-list-reconcile.v2
# CUT_LIST_BATCH_RECONCILE_RETRY_QUEUE=cut-list.production-plan.batch-cut-list-reconcile.v2.retry
# CUT_LIST_BATCH_RECONCILE_DEAD_LETTER_QUEUE=cut-list.production-plan.batch-cut-list-reconcile.v2.dlq
