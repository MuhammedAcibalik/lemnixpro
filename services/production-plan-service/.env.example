SERVICE_NAME=production-plan-service
NODE_ENV=development
LOG_LEVEL=info
ENABLE_SWAGGER=true
PORT=3004
# Local compose example: match the host port published by infra/compose/docker-compose.backend.yml.
# If your local POSTGRES_PORT is 5433, use:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lemnixpro
INTERNAL_SERVICE_AUTH_SECRET=replace-with-a-shared-internal-service-secret
